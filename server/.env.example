PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/market_fresh
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CLIENT_URL=http://localhost:5173
COOKIE_SECURE=false
ADMIN_NAME=Market Fresh Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters
SERVICE_CHARGE_PERCENT=5

# Optional SMS delivery verification (Twilio)
OTP_HASH_SECRET=replace-with-a-random-secret-at-least-32-characters
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_DEFAULT_COUNTRY_CODE=91

# Optional Stripe Checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=inr

# Meta WhatsApp Cloud API (backend only)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_ORDER_CONFIRMATION_TEMPLATE=order_confirmation
WHATSAPP_DELIVERY_TEMPLATE=delivery_notification
WHATSAPP_ORDER_STATUS_TEMPLATE=order_status_update
WHATSAPP_DEFAULT_COUNTRY_CODE=91
